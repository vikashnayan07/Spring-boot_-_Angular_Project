# Copy this file to .env on your machine or configure these values in your server/Jenkins environment.
# Never commit real secret values.

SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/machcare?currentSchema=dev
DB_USERNAME=postgres
DB_PASSWORD=<your-local-db-password>
DB_SCHEMA=dev

JWT_SECRET=<at-least-32-byte-random-secret>
JWT_EXPIRATION_MS=86400000

SERVER_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

DEMO_PASSWORD=<demo-user-password>
SMOKE_LOGIN_EMAIL=<ci-smoke-test-email>
SMOKE_LOGIN_PASSWORD=<ci-smoke-test-password>
